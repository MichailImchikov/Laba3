using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;

namespace Laba3_A
{

    public static class DataTaskReader
    {
        // Единственный публичный метод
        public static List<DataTask> LoadAll()
        {
            var dir = ResolveTaskDirectory();
            if (!Directory.Exists(dir))
                throw new DirectoryNotFoundException($"Папка с заданиями не найдена: \"{dir}\"");

            var result = new List<DataTask>();
            foreach (var file in Directory.EnumerateFiles(dir, "*.txt", SearchOption.TopDirectoryOnly)
                                          .OrderBy(f => f, StringComparer.OrdinalIgnoreCase))
            {
                result.Add(ReadFromTxt(file));
            }
            return result;
        }

        // ----- Приватные помощники -----

        private static DataTask ReadFromTxt(string path)
        {
            if (!File.Exists(path))
                throw new FileNotFoundException("Файл задания не найден", path);

            var lines = File.ReadAllLines(path)
                            .Select(l => StripComment(l).Trim())
                            .Where(l => !string.IsNullOrWhiteSpace(l))
                            .ToList();

            if (lines.Count < 3)
                throw new FormatException($"Файл \"{path}\" имеет недостаточно строк.");

            // Строка 1: n (одно целое)
            var firstTokens = SplitTokens(lines[0]);
            if (firstTokens.Count != 1 || !int.TryParse(firstTokens[0], NumberStyles.Integer, CultureInfo.InvariantCulture, out var n) || n <= 0)
                throw new FormatException($"Строка 1 в \"{path}\": ожидается положительное целое n, получено \"{lines[0]}\".");

            // Строка 2: directiveTime (ровно n значений)
            var directive = ParseIntList(lines[1], path, 2);
            if (directive.Count != n)
                throw new FormatException($"Строка 2 в \"{path}\": ожидается {n} значений, получено {directive.Count}.");

            // Далее (n+1) строк матрицы, каждая по (n+1) значений
            if (lines.Count < 2 + (n + 1))
                throw new FormatException($"В \"{path}\": ожидается {n + 1} строк матрицы после строки 2, получено {lines.Count - 2}.");

            var size = n + 1;
            var matrixRows = new List<List<int>>(size);
            for (int i = 0; i < size; i++)
            {
                var lineNo = 3 + i;
                var row = ParseIntList(lines[2 + i], path, lineNo);
                if (row.Count != size)
                    throw new FormatException($"Строка {lineNo} в \"{path}\": ожидается {size} значений, получено {row.Count}.");
                matrixRows.Add(row);
            }

            var matrix = ToRectArray(matrixRows, size, size, path);
            return new DataTask(n, directive, matrix);
        }

        private static int[,] ToRectArray(List<List<int>> src, int rows, int cols, string path)
        {
            var dst = new int[rows, cols];
            for (int i = 0; i < rows; i++)
            {
                if (src[i].Count != cols)
                    throw new FormatException($"Некорректная длина строки матрицы {i} в \"{path}\".");
                for (int j = 0; j < cols; j++)
                    dst[i, j] = src[i][j];
            }
            return dst;
        }

        private static List<int> ParseIntList(string text, string path, int lineNo)
        {
            var tokens = SplitTokens(text);
            var list = new List<int>(tokens.Count);
            for (int i = 0; i < tokens.Count; i++)
            {
                if (!int.TryParse(tokens[i], NumberStyles.Integer, CultureInfo.InvariantCulture, out var value))
                    throw new FormatException($"Не удалось разобрать целое число в \"{path}\" (строка {lineNo}, столбец {i + 1}): \"{tokens[i]}\".");
                list.Add(value);
            }
            return list;
        }

        private static List<string> SplitTokens(string text)
        {
            return text.Split(new[] { ' ', '\t', ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries).ToList();
        }

        private static string StripComment(string line)
        {
            var idxHash = line.IndexOf('#');
            var idxSlashes = line.IndexOf("//", StringComparison.Ordinal);
            int cut = -1;
            if (idxHash >= 0 && idxSlashes >= 0) cut = Math.Min(idxHash, idxSlashes);
            else if (idxHash >= 0) cut = idxHash;
            else if (idxSlashes >= 0) cut = idxSlashes;
            return cut >= 0 ? line[..cut] : line;
        }

        private static string ResolveTaskDirectory()
        {
            // 1) bin/.../Task
            var baseDir = AppContext.BaseDirectory;
            var candidate = Path.Combine(baseDir, "Task");
            if (Directory.Exists(candidate))
                return candidate;

            // 2) Подняться вверх и найти первую папку Task
            var dir = new DirectoryInfo(baseDir);
            while (dir != null)
            {
                candidate = Path.Combine(dir.FullName, "Task");
                if (Directory.Exists(candidate))
                    return candidate;
                dir = dir.Parent;
            }

            // 3) Фолбэк: текущая директория/Task
            return Path.Combine(Directory.GetCurrentDirectory(), "Task");
        }
    }
}